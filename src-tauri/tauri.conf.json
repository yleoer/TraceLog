{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TraceLog",
  "version": "0.2.0",
  "identifier": "app.tracelog.desktop",
  "build": {
    "frontendDist": "../frontend/dist/app",
    "devUrl": "http://127.0.0.1:5173",
    "beforeDevCommand": "npm.cmd --prefix frontend run dev",
    "beforeBuildCommand": "npm.cmd --prefix frontend run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "TraceLog",
        "width": 1280,
        "height": 860,
        "minWidth": 960,
        "minHeight": 680,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; script-src 'self' 'wasm-unsafe-eval'; img-src 'self' data: blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "../build/windows/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "languages": [
          "SimpChinese",
          "English"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDMwNzNGNkUxQ0NBQzcwMzkKUldRNWNLek00Zlp6TUxKK1lia2hDUjMyTzBiejh3Sy85YlpJYkx0UXB2KzdLVlU2RHFkM2xlRUEK",
      "endpoints": [
        "https://github.com/yleoer/TraceLog/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
